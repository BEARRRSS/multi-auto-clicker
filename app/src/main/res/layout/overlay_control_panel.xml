<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot"
    android:layout_width="290dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:elevation="12dp">

    <!-- ── HEADER (drag handle) ────────────────────────────── -->
    <LinearLayout
        android:id="@+id/panelHeader"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:background="@drawable/bg_panel_header">

        <!-- Drag dots -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⠿"
            android:textColor="#5A5A7A"
            android:textSize="18sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Auto Clicker"
            android:textColor="#EAEAEA"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <!-- Status dot -->
        <View
            android:id="@+id/statusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_delete_btn"
            android:layout_marginEnd="8dp" />

        <!-- Minimize button -->
        <Button
            android:id="@+id/btnMinimize"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="—"
            android:textColor="#A8A8B3"
            android:textSize="14sp"
            android:backgroundTint="@android:color/transparent"
            android:padding="0dp" />
    </LinearLayout>

    <!-- ── LOOP SECTION ───────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOOP MODE"
            android:textColor="#7A7A9A"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:layout_marginBottom="8dp" />

        <!-- Radio toggle row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_input"
            android:padding="3dp">

            <Button
                android:id="@+id/btnLoopInfinite"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="∞  Infinite"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#E94560"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnLoopFixed"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Fixed"
                android:textSize="12sp"
                android:backgroundTint="@android:color/transparent"
                android:textColor="#A8A8B3" />
        </LinearLayout>

        <!-- Loop count input (visible only when Fixed is selected) -->
        <EditText
            android:id="@+id/etLoopCount"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="Loop count (e.g. 10)"
            android:inputType="number"
            android:textColor="#EAEAEA"
            android:textColorHint="#5A5A7A"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E2A4A" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" />

    <!-- ── DELAY SECTION ──────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Delay between clicks"
            android:textColor="#A8A8B3"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etDelay"
            android:layout_width="80dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_input"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="500"
            android:inputType="number"
            android:textColor="#EAEAEA"
            android:textSize="13sp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="ms"
            android:textColor="#7A7A9A"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E2A4A" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" />

    <!-- ── CLICK POINTS SECTION ───────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvPointCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Click Points  (0)"
            android:textColor="#A8A8B3"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAddPoint"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="+ Add"
            android:textSize="11sp"
            android:textColor="#EAEAEA"
            android:backgroundTint="#4ECDC4"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <Button
            android:id="@+id/btnClearPoints"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:text="Clear"
            android:textSize="11sp"
            android:textColor="#FF6B6B"
            android:backgroundTint="#2A0F0F"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1E2A4A" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" />

    <!-- ── PROGRESS / STATUS BAR ──────────────────────────── -->
    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text=""
        android:textColor="#4ECDC4"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- ── CONTROL BUTTONS ────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnStartStop"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="▶  START"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#E94560"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:text="⚙"
            android:textSize="18sp"
            android:backgroundTint="#0F3460"
            android:textColor="#A8A8B3"
            android:padding="0dp" />
    </LinearLayout>

</LinearLayout>
